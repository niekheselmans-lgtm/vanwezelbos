{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/blogposts", "destination": "/blog/", "permanent": true },
    { "source": "/category/werkzaamheden", "destination": "/blog/", "permanent": true },
    { "source": "/feed", "destination": "/blog/", "permanent": true },
    { "source": "/wp-content/uploads/2025/10/bosbeheerplan-van-wezel-bos-V2.pdf", "destination": "/documenten/bosbeheerplan-van-wezel-bos.pdf", "permanent": true },
    { "source": "/(corporate-creative-landing|corporate-creative-news|corporate-creative-contact|ultimate-blog-landing|sample-page)", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(img|css|js|documenten)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
