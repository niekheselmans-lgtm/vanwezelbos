{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pip3 install --user -q pillow || true; python3 scripts/build.py",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/blogposts",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/category/werkzaamheden",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/wp-content/uploads/2025/10/bosbeheerplan-van-wezel-bos-V2.pdf",
      "destination": "/documenten/bosbeheerplan-van-wezel-bos.pdf",
      "permanent": true
    },
    {
      "source": "/(corporate-creative-landing|corporate-creative-news|corporate-creative-contact|ultimate-blog-landing|sample-page)",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(img|documenten)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
